# Dependencies
node_modules/
.env
.env.*
# ...but example files are documentation, not secrets, and must be committable.
# (market-opener-bot/.env.example only survives because it predates the .env.* rule.)
!.env.example
!**/.env.example

# Build artifacts
artifacts/
cache/
out/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Keys — never commit these
*.key
*.pem
mnemonic.txt

# rehearsal harness deps + local run state
scripts/node_modules/
scripts/sepolia-rehearsal-state.json
scripts/sepolia-rehearsal-v3-state.json
scripts/*.log
scripts/mainnet-deploy-state.json

# fork-test harness deps and local artifacts (the harness itself IS committed)
scripts/fork-tests/node_modules/
scripts/fork-tests/artifacts/
scripts/fork-tests/cache/
scripts/fork-tests/*.log

# prague sub-harness deps (its own hardhat, purely to get EIP-7702)
scripts/fork-tests/prague/node_modules/
scripts/fork-tests/prague/cache/
scripts/fork-tests/prague/artifacts/
scripts/fork-tests/prague/package-lock.json

# one-off mainnet smoke-test relay key (throwaway, but still a key)
scripts/mainnet-smoke-v3-relay.json
scripts/mainnet-deploy-v3-state.json
