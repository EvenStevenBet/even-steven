# ─── CONTROLS ────────────────────────────────────────────────────────────
# Kill switch. Must be exactly "true" to allow any deployment.
# Leave false to make the bot read-only while you're still setting up.
BOT_ENABLED=false

# Dry run. true = simulate everything, write nothing (chain or sheet).
# Set to false only once a dry run log looks right.
DRY_RUN=true

# Max markets open at the same time, counted live from the factory.
# Raise this single number when you want more concurrent markets.
MAX_OPEN_MARKETS=3

# The value column K must contain for a row to be deployable.
APPROVAL_TOKEN=yes

# ─── CHAIN ───────────────────────────────────────────────────────────────
# SECRETS BELONG IN ~/.even-steven/bot.env, NOT HERE. This folder is under
# ~/Desktop, which is iCloud-synced. src/env.ts layers the two files — the home
# file wins, this one fills the rest — so leave these blank in the repo copy.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Production wallet private key. NEVER commit the real .env file.
PRIVATE_KEY=0xYOUR_PRODUCTION_WALLET_PRIVATE_KEY

# The bot refuses to run unless PRIVATE_KEY resolves to this exact address.
# "Even Steven Prod v3" — deploys v3 AND owns Factory v1.6, so createMarket
# (onlyOperatorOrOwner) passes with no addOperator call.
# SUPERSEDED: 0x6cF0A0b5282409E24dC35e2c1834f9111315603B still owns Factory v1.5
#             and its market — keep it funded, but do not use it here.
# DEPRECATED: 0x4A273d9C973841Da994f820C2e2d82E754C16862 — do not use.
PRODUCTION_WALLET=0x2e5Ff49699f0dA2E8A6a43f34BffC1c740E67916

# SportsbookFactory v1.6 (Base mainnet) — deployed and verified 2026-09-23.
# SUPERSEDED, do not use:
#   v1.5 0xf69d4c986bb9fa8177e74b8cb9e2c49f4200adbd — replaced by v1.6 (v3: claimPayoutFor,
#        placeBetForWithSignature). Its one market is settled and claimed.
#   v1.4 0xB09aD0b9B52E628328151505580be1A632326E0c
#   v1.3 0x9E9C769aaCa509cD67Fbca2236dB26d8428a8027 — deployed v1.8.1 markets that cannot
#        settle (UMA identifier bug, since fixed)
FACTORY_ADDRESS=0x5906370b9831728ec523b647137a1bbf0ab45390

# Circle USDC (Base mainnet)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── GITHUB CSV ──────────────────────────────────────────────────────────
# Personal Access Token with repo contents:write permission
GITHUB_TOKEN=ghp_yourTokenHere

GITHUB_REPO_OWNER=EvenStevenBet
GITHUB_REPO_NAME=even-steven
GITHUB_CSV_PATH=data/markets.csv

# ─── OPTIONAL ────────────────────────────────────────────────────────────
# How long to wait for a transaction receipt before failing loudly (ms).
RECEIPT_TIMEOUT_MS=180000
LOG_DIR=./logs
